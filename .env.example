# -------------------------------------------------------------
# VoxSell Environment Configuration
# -------------------------------------------------------------

# Application
APP_NAME=VoxSell
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# PostgreSQL (Async for FastAPI, Sync for Alembic)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voxsell_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/voxsell_db

# Redis (Session state, queues, pub/sub)
REDIS_URL=redis://localhost:6379/0

# ChromaDB (Vector Store for RAG)
CHROMA_PERSIST_DIR=./knowledge_base/chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Deepgram (Streaming STT)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# TTS Provider Configuration
TTS_PROVIDER=deepgram_aura
TTS_API_KEY=your_tts_api_key_here
TTS_VOICE_ID=aura-asteria-en

# Google Calendar Integration
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=primary

# CRM Integration (HubSpot / Postgres CRM)
CRM_PROVIDER=postgres
HUBSPOT_ACCESS_TOKEN=your_hubspot_token_here
